{
  "name": "ecg-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "desktop": "electron .",
    "dev:desktop": "node scripts/dev-desktop.cjs",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "plotly.js-dist-min": "2.35.3"
  },
  "devDependencies": {
    "vite": "^6.4.0",
    "electron": "^39.0.0",
    "concurrently": "9.1.2",
    "wait-on": "8.0.3",
    "electron-builder": "^26.0.12"
  },
  "productName": "ECG Analyzer",
  "build": {
    "appId": "org.ecganalyzer.lab",
    "productName": "ECG Analyzer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-python/ecg-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/ecg.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "electron/assets/ecg.ico",
      "uninstallerIcon": "electron/assets/ecg.ico"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "ECG-Analyzer-Setup-${version}-${arch}.${ext}"
  }
}
